<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="v1/index.xsl"?>
<pages title="State Library of South Australia: Little Library " css='css/custom.css' js='js/custom.js'>
  <header>
  </header>

  <page title='Overview'>
    <row>
      <column sm="12">
        <row>
          <column sm='12' md='6'>
            <subtitle>Little Library</subtitle>
            <!-- Button heights come from .routing-btn; see css/custom.css. The
                 same class is on the Lighting and Audio Routing buttons below,
                 so all three blocks match. -->
            <row>
              <column sm='6'>
                <button action='All Power' arg='Off' event='All Power' class-on="btn-danger" class="btn-default btn-block btn-lg routing-btn" confirm='true'>All Off</button>
              </column>
              <column sm='6'>
                <button action='All Power' arg='On' event='All Power' class-on='btn-success' class="btn-default btn-block btn-lg routing-btn" confirm='true'>All On<icon type='on'/></button>
              </column>
            </row>
            <subtitle>Lighting Controls</subtitle>
            <row>
              <!-- These cannot use join=. The Dynalite scenes are 'custom messages', which the
                   recipe creates as an Action with no matching Event (LTL-LIB-DYNALITE script.py
                   ~281), so a join'd event half has nothing to bind to and never latches. State
                   comes instead from the single per-area signal 'Area:2 Preset', which the recipe
                   emits when a DyNet message for that area is *received* - so the highlight
                   follows the bus, including wall panels, rather than what we last sent.

                   arg= MUST be the scene's label from LTL-LIB-DYNALITE's 'labelling' param, and
                   MUST NOT be the bare preset number. nodel.js matches with $.inArray, which is
                   strict ===, against jQuery's .data('arg') - and .data() coerces a numeric-looking
                   attribute to a Number. So arg='11' becomes 11, the signal emits the string '11',
                   11 === '11' is false, and the button never lights. A non-numeric label stays a
                   string and compares correctly. The same labels are what LTL-LIB-LIGHTING-POWER
                   matches in its onStates/offStates, so the two must stay in step. -->
              <column sm='4'><button action='Lighting Gallery On' event='Lighting Area 2 Preset' arg='Gallery On' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Gallery On</button></column>
              <column sm='4'><button action='Lighting All Off' event='Lighting Area 2 Preset' arg='All Off' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn" confirm='true'>All Off</button></column>
              <column sm='4'><button action='Lighting Cleaning On' event='Lighting Area 2 Preset' arg='Cleaning On' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Cleaning On</button></column>
            </row>
            <subtitle>Exhibits</subtitle>
            <status page="Play" event='Play Status'>Play<partialswitch join='Play Power' class='btn-light'></partialswitch></status>
            <status event='Sing Status'>Sing<partialswitch join='Sing Power' class='btn-light'></partialswitch></status>
            <subtitle>Audio Routing</subtitle>
            <row>
              <column sm='4'><button join='Split Room' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Split Room</button></column>
              <column sm='4'><button join='Play Audio Takeover' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Play Audio Takeover</button></column>
              <column sm='4'><button join='Sing Audio Takeover' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Sing Audio Takeover</button></column>
            </row>
          </column>
          <column sm='12' md='6'>
            <subtitle>Help</subtitle>
            <text>Please visit the 'Art Processors Extranet' for knowledge base articles and troubleshooting guides.</text>
            <text>To raise a support request, please access the 'Art Processors Service Desk' and use the credentials provided to you.</text>
            <text>If you are unable to login to the Service Desk or Extranet, please email support@artprocessors.net.</text>
          </column>
        </row>
      </column>
    </row>
  </page>

  <!-- Calendar: the schedule editor from the LTL-LIB-SCHEDULER node
       (content/frontend.xml + css + js), lifted here the same way the Media
       Player tab was lifted from xxMPV-frontend.
       js/scheduler-calendar.js REPLACES the whole of this page's markup with
       the calendar UI as soon as it loads, so what follows is only what an
       operator sees if that script fails - keep it, but there is no point
       adding controls here. Unlike every other tab, nothing on this page is
       bound to anything: the calendar reads and writes the scheduler node's
       'Schedules' parameter over REST directly, so there is nothing for the
       Mk 2 recipe to create and nothing to wire in the Bindings editor. -->
  <page title='Calendar'>
    <row>
      <column sm="12">
        <title>Schedule calendar</title>
        <text>Loading the calendar editor.</text>
      </column>
    </row>
  </page>

    <page title="Play">
      <row>
        <column sm='12'>
          <row>
            <column sm="4">
              <row>
                <column sm="12">
                  <title>Volume</title>
                  <range event='Play Volume' action='Play Volume' min='-53' max='-6'></range>
                </column>
                <column sm="12">
                  <meter event='Play Level' type='horizontal' range='db'/>
                </column>
              </row>
              <row>
                <column sm="12">
                  <title>BlockHeads Interactive</title>
                  <!-- Two-line status labels use a literal LF (&#10;) rather than <br/>:
                       templates.xsl renders the label with <xsl:value-of select="text()"/>,
                       which drops element children and would truncate the label at the first
                       text node. css/custom.css puts status labels in white-space: pre-line
                       so the newline renders as a break. -->
                  <status event='Play BlockHead PC Status'>PC&#10;(Tea Room Comms Rack)<partialswitch join='Play BlockHead PC Power'/><button action='Play BlockHead PC Restart' confirm='true' class='btn-light loop-btn'>&#8634;</button></status>
                  <status event='Play Unity App Status'>Software&#10;(Unity)<partialswitch join='Play Unity App Power'/><button action='Play Unity App Restart' confirm='true' class='btn-light loop-btn'>&#8634;</button></status>
                  <status event='Play Projector Status'>Projector&#10;(EPSON EB-PU1007W / ELPLX01 lens)<partialswitch join='Play Projector Power'/></status>
                  <title size='6'>Screenshot (updated every 60 seconds)</title>
                  <image source='data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==' event='Play BlockHead Screenshot'></image>
                </column>
              </row>
            </column>
            <column sm='4'>
              <title>Scanner 01 (Multipurpose Side)</title>
              <status event='Play Scanner PC 01 Status'>PC&#10;(Cupboard under scanner)<partialswitch join='Play Scanner PC 01 Power'/><button action='Play Scanner PC 01 Restart' confirm='true' class='btn-light loop-btn'>&#8634;</button></status>
              <status event='Play Scanner Software 01 Status'>Software&#10;(ScanSnap Home)<partialswitch join='Play Scanner Software 01 Power'/><button action='Play Scanner Software 01 Restart' confirm='true' class='btn-light loop-btn'>&#8634;</button></status>
              <status event='Play Scanner 01 Status'>Scanner&#10;(Device)<partialswitch join='Play Scanner 01 Power'/><button action='Play Scanner 01 Restart' confirm='true' class='btn-light loop-btn'>&#8634;</button></status>
              <status event='Play SwitchBot 01 Status'>SwitchBot<button action='Play SwitchBot 01 Press' class='btn-default'>Press</button></status>
            </column>
            <column sm='4'>
              <title>Scanner 02 (Entryway Side)</title>
              <status event='Play Scanner PC 02 Status'>PC&#10;(Cupboard under scanner)<partialswitch join='Play Scanner PC 02 Power'/><button action='Play Scanner PC 02 Restart' confirm='true' class='btn-light loop-btn'>&#8634;</button></status>
              <status event='Play Scanner Software 02 Status'>Software&#10;(ScanSnap Home)<partialswitch join='Play Scanner Software 02 Power'/><button action='Play Scanner Software 02 Restart' confirm='true' class='btn-light loop-btn'>&#8634;</button></status>
              <status event='Play Scanner 02 Status'>Scanner&#10;(Device)<partialswitch join='Play Scanner 02 Power'/><button action='Play Scanner 02 Restart' confirm='true' class='btn-light loop-btn'>&#8634;</button></status>
              <status event='Play SwitchBot 02 Status'>SwitchBot<button action='Play SwitchBot 02 Press' class='btn-default'>Press</button></status>
            </column>
          </row>
        </column>
      </row>
    </page>
    <page title="Multipurpose">
      <row>
        <column sm='12'>
          <!-- .mp-cols flexes its columns to equal height (sm and up). Nothing inside
               them stretches or is repositioned - everything is at its natural size
               and in normal flow. See css/custom.css.

               Three sm='4' columns: audio controls with Audio Routing beneath them,
               Projector Input with Lighting Controls beneath it, and the Equipment
               list. -->
          <row class='mp-cols'>
            <column sm="4">
              <row>
                <column sm="12">
                  <title>Program audio</title>
                  <range event='Multipurpose Volume' action='Multipurpose Volume' min='-53' max='10'></range>
                </column>
                <column sm="9">
                  <meter event='Multipurpose Level' type='horizontal' range='db'/>
                </column>
                <!-- Aux Audio rides alongside the Program audio meter as a small
                     btn-sm - deliberately NOT routing-btn/btn-lg, which are the
                     chunky styles used for the full-size scene buttons.

                     Mute/unmute toggle. Deliberately a bare join= with no arg: that
                     sends {} (i.e. calls the action with no argument), and the amp
                     node treats a no-arg call as "flip whatever you last reported".
                     Doing it there rather than with arg-on/arg-off keeps the toggle
                     right on a freshly-loaded page and in a second browser, neither
                     of which can infer the state from this button's own colour.

                     The signal is 'Enabled', not 'Muted', so blue = audible reads
                     straight off the amplifier's own value with no inversion here.
                     It is a boolean, which is what makes class-on latch AND unlatch
                     off a bare join=. The numeric Projector Input buttons below need
                     an arg= as well; see the note there. -->
                <column sm="3">
                  <button join='Multipurpose Aux Audio' class-on='btn-primary' class="btn-default btn-block btn-sm">Aux Audio</button>
                </column>
              </row>
              <title>Handheld Mic</title>
              <range event='Multipurpose Mic 01 Level' action='Multipurpose Mic 01 Level' min='-30' max='10'></range>
              <meter event='Multipurpose Mic 01 Meter' type='horizontal' range='db'/>

              <title>Lav Mic</title>
              <range event='Multipurpose Mic 02 Level' action='Multipurpose Mic 02 Level' min='-30' max='10'></range>
              <meter event='Multipurpose Mic 02 Meter' type='horizontal' range='db'/>

              <!-- Audio Routing: sits under the faders in normal flow, and keeps the
                   Overview tab's IN-LINE arrangement - three sm='4' sub-columns side
                   by side - rather than the stacked btn-block used by Projector Input
                   opposite.

                   This is a deliberate SECOND COPY of the Overview tab's controls,
                   reusing the very same three signals ('Split Room', 'Play Audio
                   Takeover', 'Sing Audio Takeover') rather than 'Multipurpose *' ones.
                   Because the join names are identical, the Mk 2 recipe creates nothing
                   new, both tabs drive the same actions, and class-on latches on both
                   pages off the same events - so the state shown here and on Overview
                   can never disagree. Do NOT rename these to make them "belong" to this
                   tab; that would orphan the shared binding. -->
              <title>Audio Routing</title>
              <row>
                <column sm='4'><button join='Split Room' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Split Room</button></column>
                <column sm='4'><button join='Play Audio Takeover' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Play Audio Takeover</button></column>
                <column sm='4'><button join='Sing Audio Takeover' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Sing Audio Takeover</button></column>
              </row>
            </column>
            <column sm='4'>
              <!-- Matrix-switcher crosspoint select: exactly one input can be live
                   on the projector output, so all four buttons share ONE signal,
                   'Multipurpose Projector Input', and are told apart by arg=.

                   Pressing sends the arg as the action argument (-> the switcher's
                   'Route Output 1', which takes the input number). The same signal
                   coming back carries the switcher's own 'Output 1 Input' number,
                   and nodel.js latches class-on only on the button whose data-arg
                   equals it, clearing every other - so the blue follows the device,
                   is mutually exclusive for free, and self-corrects if the input is
                   changed from the panel or another browser.

                   This is why these are no longer four separate joins: a bare join
                   with no arg only latches on a boolean signal, which is what left
                   them inert. The arg is what makes a numeric signal work. -->
              <title>Projector Input</title>
              <button join='Multipurpose Projector Input' arg='1' class-on='btn-primary' class="btn-default btn-block btn-lg">Sing PC</button>
              <button join='Multipurpose Projector Input' arg='2' class-on='btn-primary' class="btn-default btn-block btn-lg">Apple TV</button>
              <button join='Multipurpose Projector Input' arg='3' class-on='btn-primary' class="btn-default btn-block btn-lg">HDMI Wall Plate</button>
              <button join='Multipurpose Projector Input' arg='4' class-on='btn-primary' class="btn-default btn-block btn-lg">HDMI Lead</button>

              <!-- Lighting: sits directly under Projector Input in normal flow.
                   Same three-across treatment as Audio Routing, and the
                   Overview tab's routing-btn styling, but with no <group> wrapper
                   (that renders the grey .well panel) and its own 'Multipurpose
                   Lighting *' signals - unlike Audio Routing, nothing here is shared
                   with the Overview lighting buttons. -->
              <title>Lighting Controls</title>
              <row>
                <!-- action=/event=/arg= rather than join=, for the same reason as the Overview
                     lighting buttons above, including the must-not-be-numeric rule for arg=.
                     These are area 101, so they latch off 'Area:101 Preset' - a different signal
                     to the Overview trio, which is what the note above means by nothing being
                     shared between the two sets. -->
                <column sm='4'><button action='Multipurpose Lighting Normal' event='Multipurpose Lighting Area 101 Preset' arg='Multipurpose - Normal' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Normal</button></column>
                <column sm='4'><button action='Multipurpose Lighting Lower' event='Multipurpose Lighting Area 101 Preset' arg='Multipurpose - Low' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Lower</button></column>
                <!-- No confirm= here: this only darkens the Multipurpose room, so
                     the prompt was friction in the middle of an event. The Overview
                     tab's 'All Off' keeps its confirm - that one kills the whole
                     Little Library. -->
                <column sm='4'><button action='Multipurpose Lighting Off' event='Multipurpose Lighting Area 101 Preset' arg='Multipurpose - Off' class-on='btn-primary' class="btn-default btn-block btn-lg routing-btn">Off</button></column>
              </row>
            </column>
            <!-- Equipment: the third column. Same status-block idiom as the Play tab -
                 a <status> whose event drives the indicator, with a <partialswitch>
                 for power. Two-line labels use a literal LF (&#10;), never <br/>:
                 templates.xsl emits the label via <xsl:value-of select="text()"/>,
                 which drops element children; css/custom.css puts status labels in
                 white-space: pre-line so the newline renders as a break.
                 Apple TV carries no status event - it is a passive, switched device
                 with no feedback, so it sits last.
                 This was a two-column list of its own when it ran full-width below;
                 in a third of the page the blocks stack in one column instead. -->
            <column sm='4'>
              <title>Equipment</title>
              <status event='Multipurpose Projector Status'>Projector&#10;(EPSON EB-690SE)<partialswitch join='Multipurpose Projector Power'/></status>
              <status event='Multipurpose Sing PC Status'>Sing PC&#10;(Cupboard Mini Rack)<partialswitch join='Multipurpose Sing PC Power'/><button action='Multipurpose Sing PC Restart' confirm='true' class='btn-light loop-btn'>&#8634;</button></status>
              <status event='Multipurpose Media Player Status'>Media Player Software<partialswitch join='Multipurpose Media Player Power'/></status>
              <status>Apple TV&#10;(Cupboard Mini Rack - Outlet power)<partialswitch join='Multipurpose Apple TV Power'/></status>
            </column>
          </row>
        </column>
      </row>
    </page>

    <!-- Media Player: the mpv playlist controller, lifted from the xxMPV-frontend
         node (content/index.xml + css + js). The engine is the mpv driver node
         (xxMPV-dev); every action/event below is bound to it in the Bindings editor,
         exactly like the rest of this dashboard. -->
    <page title="Media Player">

      <!-- Scoping root for this tab. Nodel renders this as <div class="row mpv-root">,
           and it wraps both tiles below, so js/custom.js can key every DOM read/write
           off .mpv-root. That keeps the injected playlist editor inside this page and
           lets it coexist with the sibling tabs of this dashboard. -->
      <row class='mpv-root'>
        <column sm='6'>
          <group>
            <title>Playlists</title>
            <!-- js/custom.js injects (within .mpv-root): +Add (into title), dropdown +
                 name field, toolbar, Included list, Available media list, Save playlist -->
          </group>
        </column>
        <column sm='6'>
          <group>
            <title>Playback</title>
            <!-- Playback control row: flexed (via .mpv-playback-row) so the left
                 and right columns are equal height. Start fills the left column,
                 so its bottom lines up with the bottom of Prev/Next on the right. -->
            <row class='mpv-playback-row'>
              <!-- Start: big dual-purpose Play / Pause-Resume button, 5 cols wide
                   so it reads on a tablet. -->
              <column sm='5'>
                <button action='Play' class='btn-success mpv-bigbtn mpv-play-btn'>Start <icon lib='fa' type='play' style='fas'/></button>
              </column>
              <!-- Transport controls, right of Start: Stop across the top, then
                   Prev + Next side by side (half each, together = Stop's width). -->
              <column sm='7'>
                <row>
                  <column sm='12'>
                    <button action='Stop' class='btn-danger mpv-bigbtn mpv-stop-btn'>Stop <icon lib='fa' type='stop' style='fas'/></button>
                  </column>
                </row>
                <row class='mpv-transport'>
                  <column sm='6'>
                    <button action='Previous' class='btn-primary mpv-bigbtn'>Prev <icon lib='fa' type='step-backward' style='fas'/></button>
                  </column>
                  <column sm='6'>
                    <button action='Next' class='btn-primary mpv-bigbtn'>Next <icon lib='fa' type='step-forward' style='fas'/></button>
                  </column>
                </row>
              </column>
            </row>
            <!-- Loop: directly under Start, same width (5 cols), own height. -->
            <row>
              <column sm='5'>
                <button action='LoopToggle' class='mpv-bigbtn mpv-loopbtn mpv-loop-off'>Loop playlist <icon lib='fa' type='redo' style='fas'/></button>
              </column>
            </row>
            <!-- js/custom.js injects the mpv running-status block here -->
          </group>
        </column>
      </row>

      <!-- Signal declarations for the JavaScript-driven half of this tab.
           The Mk 2 recipe (script.py) walks EVERY element of this file and creates a
           local action/event plus a remote-binding stub for each action= / event=
           attribute, so this block is how js/custom.js's REST calls (which are made
           against this node) get a surface to call. The buttons above already declare
           Play / Stop / Previous / Next / LoopToggle.
           It renders nothing: index.xsl only transforms the <column> children of a
           <row> (and the <row> children of a <page>), so these bare children are
           dropped by the stylesheet; .mpv-declare{display:none} in css/custom.css is a
           belt-and-braces guard. Do NOT delete - the Media Player tab needs it. -->
      <row class='mpv-declare'>
        <!-- actions js/custom.js calls -->
        <button action='PauseToggle'/>
        <button action='PlayFile'/>
        <button action='SetSelection'/>
        <button action='SetPosition'/>
        <button action='Rescan'/>
        <button action='AutoNumber'/>
        <button action='ClearSelection'/>
        <button action='ClearOrdering'/>
        <button action='NewPlaylist'/>
        <button action='RecallPreset'/>
        <button action='SavePreset'/>
        <button action='DeletePreset'/>
        <!-- events js/custom.js polls -->
        <signal event='Files'/>
        <signal event='Presets'/>
        <signal event='EditingPreset'/>
        <signal event='NowPlaying'/>
        <signal event='PlayReady'/>
        <signal event='Paused'/>
        <signal event='Loop'/>
        <signal event='MPVRunning'/>
      </row>

    </page>

</pages>
